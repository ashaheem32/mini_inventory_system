# Copy to frontend/.env.local and adjust. Values are baked in at build time.

# Django API origin (no trailing slash). Must be listed in the backend CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ISO 4217 code used to display prices. Prices are stored without a currency.
VITE_CURRENCY=USD

# BCP 47 locale for number formatting. Fixed so display does not depend on the viewer's browser.
VITE_LOCALE=en-US
