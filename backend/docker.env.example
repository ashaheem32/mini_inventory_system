# Optional overrides for the Docker backend. Copy to backend/docker.env.
# Never commit docker.env.

# Leave empty to generate one on first start and keep it in the data volume.
DJANGO_SECRET_KEY=

# Password for the demo user when it is first created by seed_data.
DEMO_PASSWORD=demo-pass-2026

# Seed demo data on every start (idempotent). Set to false for an empty inventory.
SEED_ON_START=true

LOGIN_THROTTLE_RATE=10/min
