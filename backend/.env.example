# Copy to backend/.env and adjust. Never commit the real .env file.

# true for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed by CORS (Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file path, relative to backend/ or absolute.
SQLITE_PATH=db.sqlite3

# Login attempts allowed per client IP.
LOGIN_THROTTLE_RATE=10/min

# Password used by `manage.py seed_data` when it creates the demo user.
DEMO_PASSWORD=demo-pass-2026
